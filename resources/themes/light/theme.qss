/* ========================================================================= */
/* File: theme.qss (light)                                                   */
/* Description: PROTEUS light theme. Reproduces the historical look of the   */
/*              application. Icon URLs use the "theme:" search path which    */
/*              is configured to fall back to resources/, so the existing    */
/*              icon assets are reused without duplication.                  */
/* ========================================================================= */

/* ========================================================================= */
/* General styles                                                            */
/* ========================================================================= */

/*Error label displayed in forms =========================================== */
QLabel#error_label{
    color: red;
    font: bold;
}

/* Description state labels (themable replacement for inline setStyleSheet)  */
/* Set via QWidget.setProperty("descriptionState", "empty"|"filled") and a   */
/* polish/unpolish nudge — see proteus.views.forms.style_helpers.            */
QLabel[descriptionState="empty"] {
    color: red;
    font-style: italic;
}

QLabel[descriptionState="filled"] {
    color: black;
    font-style: italic;
}

/* Remove outline dotted border */
QAbstractItemView {
    outline: 0;
}

QAbstractItemView::item:selected {
    outline: 0;
}



/* QListWidget ------------------------------------------------------------- */

QListWidget {
    border: 1px solid gainsboro;
    border-radius: 1px;
}

/* QCalendarWidget --------------------------------------------------------- */
QCalendarWidget QToolButton {
    font: bold;
  	color: white;
    background-color: transparent;

    padding-right: 0.7em;

    border-color: transparent;
    border-radius: 0;
}

QCalendarWidget QToolButton::menu-indicator {
    subcontrol-origin: right;
    subcontrol-position: right center;
}

QCalendarWidget QToolButton::hover {
    background-color: #004589;
    border-color: #004589;
    border-radius: 0;
}

QCalendarWidget QToolButton:pressed {
    background-color: #89c4ff;
}

QCalendarWidget QAbstractItemView::item:selected {
    background-color: #0080ff;
}

/* These are internal PyQt widget names, this is a workaround to modify
QCalendarWidget style since it was affected by other app general styles */
QCalendarWidget #qt_calendar_navigationbar {
    background-color: #0080ff;
}

QCalendarWidget #qt_calendar_prevmonth {
    padding: 0.15em;
    qproperty-icon: url(theme:icons/calendar/prev-month.png);
}
QCalendarWidget #qt_calendar_nextmonth {
    padding: 0.15em;
    qproperty-icon: url(theme:icons/calendar/next-month.png);
}


/* QTreeView/QListWidget items --------------------------------------------- */
QTreeView::item {
    padding: 0em;
}

QListWidget::item {
    padding: 0.1em;
}

QTreeView::item:hover, QListWidget::item:hover {
    background-color: azure;
}

QTreeView::item:selected, QListWidget::item:selected {
    background-color: lightcyan;
    color: black;
}


/* QTreeView Tree lines ---------------------------------------------------- */
/* Full-row selection in the branch column, with treelines visible.
   Qt 6.5 painted the whole row (branch column included) uniformly with
   the selection color. Qt 6.7+ left that paint in place but the per-shape
   border-images below render on top, and the selection paint shows
   through the transparent areas of the PNGs.

   These rules paint the branch column explicitly with the selection color
   so the QSS layer "owns" the branch background. The per-shape border-
   image rules below still apply (their properties don't conflict with
   ours), so treelines remain visible — drawn over the selection color
   instead of behind it. */
QTreeView::branch:has-siblings:!adjoins-item:selected,
QTreeView::branch:has-siblings:adjoins-item:selected,
QTreeView::branch:!has-children:!has-siblings:adjoins-item:selected,
QTreeView::branch:has-children:!has-siblings:closed:selected,
QTreeView::branch:closed:has-children:has-siblings:selected,
QTreeView::branch:open:has-children:!has-siblings:selected,
QTreeView::branch:open:has-children:has-siblings:selected {
    background-color: lightcyan;
}

QTreeView::branch:has-siblings:!adjoins-item:hover,
QTreeView::branch:has-siblings:adjoins-item:hover,
QTreeView::branch:!has-children:!has-siblings:adjoins-item:hover,
QTreeView::branch:has-children:!has-siblings:closed:hover,
QTreeView::branch:closed:has-children:has-siblings:hover,
QTreeView::branch:open:has-children:!has-siblings:hover,
QTreeView::branch:open:has-children:has-siblings:hover {
    background-color: azure;
}

QTreeView::branch:has-siblings:!adjoins-item {
    border-image: url(theme:icons/treelines/vline.png) 0;
}

QTreeView::branch:has-siblings:adjoins-item {
    border-image: url(theme:icons/treelines/branch-more.png) 0;
}

QTreeView::branch:!has-children:!has-siblings:adjoins-item {
    border-image: url(theme:icons/treelines/branch-end.png) 0;
}

QTreeView::branch:has-children:!has-siblings:closed,
QTreeView::branch:closed:has-children:has-siblings {
        border-image: none;
        image: url(theme:icons/treelines/branch-closed.png);
}

QTreeView::branch:open:has-children:!has-siblings,
QTreeView::branch:open:has-children:has-siblings  {
        border-image: none;
        image: url(theme:icons/treelines/branch-open.png);
}

/* QComboBox --------------------------------------------------------------- */

QComboBox {
    padding: 0.15em;
    min-width: 4em;
}

QComboBox:hover {
    background-color: azure;
    border: 1px solid skyblue;
}

QComboBox:disabled {
    background-color: #f3f3f3;
    border: 1px solid #e1e1e1;
}

/* QComboBox AbstractItemView ---------------------------------------------- */

QComboBox QAbstractItemView {
    border: 1px solid skyblue;
    border-bottom-left-radius: 1px;
    border-bottom-right-radius: 1px;
}

QComboBox QAbstractItemView::item {
    padding: 0.1em;
}

QComboBox QAbstractItemView::item:hover {
    background-color: azure;
    color: black;
}


/* QComboBox::down-arrow --------------------------------------------------- */
QComboBox::drop-down {
    subcontrol-origin: padding;
    subcontrol-position: top right;

    border: 0;
    border-left: 1px solid gainsboro;
    padding: 0.15em;
}

QComboBox::down-arrow {
    image: url(theme:icons/treelines/expand-arrow.png);
    width: 0.8em;
    height: 0.8em;
}

QComboBox::down-arrow:on { /* shift the arrow when popup is open */
    image: url(theme:icons/treelines/expand-arrow-reverse.png);
    width: 0.8em;
    height: 0.8em;
}

/* Tabs style -------------------------------------------------------------- */
QTabBar::tab {
    background-color: #f9f9f9;
    min-width: 3em;
    padding: 0.2em;
    padding-left: 0.5em;
    padding-right: 0.5em;

    border-top-left-radius: 1px;
    border-top-right-radius: 1px;
    border-top: 1px solid #e1e1e1;
    border-left: 1px solid #e1e1e1;
    border-right: 1px solid #e1e1e1;
}

QTabBar::tab:selected {

}

QTabBar::tab:hover:!selected {
    margin-top: 0;
    background-color: azure;
}

QTabBar::tab:!selected {
    margin-top: 0.2em;
    background-color: #ececec;
}

/* QToolButton | QPushButton ----------------------------------------------- */

/* Button box groups (save, accept, etc) */
QDialogButtonBox QPushButton {
    min-width: 4em;
    padding: 0.15em;
}

QPushButton {
    padding: 0.1em;
}

QToolButton, QPushButton {
    /* background */
    background-color: white;

    /* border */
    border: 1px solid gainsboro;
    border-radius: 3px;

    /* margin */
    margin: 1px;
}

QToolButton:hover, QPushButton:hover {
    background-color: azure;
    border: 1px solid skyblue;
}

QToolButton:pressed, QPushButton:pressed {
    background-color: lightcyan;
}

QToolButton:disabled, QPushButton:disabled {
    background-color: #f3f3f3;
    border: 1px solid #e1e1e1;
}


/* QCheckbox --------------------------------------------------------------- */

QCheckBox {
    padding: 0.15em;
}

QCheckBox:hover {
    background-color: azure;
    border: 1px solid skyblue;
    border-radius: 3px;
}

QCheckBox:pressed {
    background-color: lightcyan;
}

/* QGroupBox --------------------------------------------------------------- */
/* Used in dialogs (settings, property editors, trace editors) — a thin
   subtle border reads cleaner than the default native 2px frame. */
QGroupBox {
    border: 1px solid gainsboro;
    border-radius: 3px;
    margin-top: 0.6em;
}

QGroupBox::title {
    subcontrol-origin: margin;
    left: 0.5em;
    padding: 0 0.3em;
}

/* ========================================================================= */
/* DocumentContainer component                                               */
/* ========================================================================= */



/* ========================================================================= */
/* DocumentTree component                                                    */
/* ========================================================================= */
/* QTreeWidget subclass */
#DocumentTree {
    border: 0;
}



/* ========================================================================= */
/* ProjectContainer component                                                */
/* ========================================================================= */
/* QWidget subclass */

#ProjectContainer QSplitter::handle {
    border-left: 1px solid slategray;
    border-right: 1px solid slategray;

    background-color: #f1f1f1;
}

#ProjectContainer QSplitter::handle:horizontal {
    width: 2px;
}

/* ========================================================================= */
/* StatusBar widgets                                                         */
/* ========================================================================= */

#MetricsIndicator QWidget {
    background-color: #ffe7e7e7;
    padding: 0.1em;
    border: 1px solid gainsboro;
}

#clipboard_indicator {
    background-color: #ffe7e7e7;
    border: 1px solid gainsboro;
}

#clipboard_indicator QLabel {
    padding: 0.1em;
}

/* ========================================================================= */
/* MainMenu component                                                        */
/* ========================================================================= */
/* QDockWidget subclass */

/* Profile information icon (menu) */
#MainMenu #profile_information {
    min-width: 140px;
    border-left: 1px solid slategray;
    padding-left: 0;
    margin-left: 0;
}


#MainMenu QTabWidget::pane{
    margin-right: 0px;
    padding-right: 0px;
}

/* Menu bottom border */
#MainMenu #main_menu_container {
    border-bottom: 1px solid slategray;
}


/* Main menu background colors */
#MainMenu QWidget#main_tab {
    background-color: #f9f9f9;
}

#MainMenu QWidget#archetype_tab {
    background-color: #f9f9f9;
}


/* Main menu QToolButton (app main fixed buttons open, edit, etc) ---------- */
#MainMenu QToolButton {
    margin: 0.08em;
    padding: 0.15em;
    padding-right: 0.2em;
    padding-left: 0.2em;
}

/* Archetypes scroll area */
#MainMenu QScrollArea {
    border: 0;
    background-color: transparent;
}
#MainMenu #archetype_button_group { background-color: transparent; }


/* Archetype menu buttons -------------------------------------------------- */
#archetype_menu_button {
    margin-right: 0.5em;
    margin-left: 0.5em;
}

/* menu button arrow */
#archetype_menu_button::menu-button {
    subcontrol-origin: padding;
    subcontrol-position: right;
    /* left: 0.2em; */

    border: 0;
    /* border-left: 1px solid gainsboro; */
}

#archetype_menu_button::menu-arrow {
    width: 1em;
    height: 1em;
}

#archetype_menu_button::menu-button:hover {
    /* border-left: 1px dashed skyblue; */
}

#archetype_menu_button::menu-button:pressed {
}

#archetype_menu_button::menu-button:disabled {
    /* border-left: 1px dashed #e1e1e1; */
}

/* ========================================================================= */
/* Views container                                                           */
/* ========================================================================= */
#ViewsContainer QTabBar::tab{
    min-height: 32px;
}

/* ========================================================================= */
/* Dialogs                                                                   */
/* ========================================================================= */
#dialog_content_widget { background-color: #f9f9f9; }

#PropertyDialog #dialog_content_widget { background-color: transparent; }


/* This overrides the 0 padding for the QTreeWidget, then it is easier
to identify items on a list */
#PropertyDialog QTreeView::item {
    padding: 0.1em;
}


/* QWizard (New project dialog) */
QWizard QPushButton {
    margin: 1px;
    min-height: 1em;
    padding-left: 0.75em;
    padding-right: 0.75em;
}

QWizard QLineEdit:disabled {
    background-color: #ffffff;
    border: 1px solid #e1e1e1;
}
