<?xml version="1.0" encoding="UTF-8"?>
<!--
  Dark theme icon overrides.

  Loaded as a delta on top of the light-theme baseline — only chrome icons
  that would be unreadable on a dark surface are listed here. Profile icons
  still load after this manifest, so domain content stays under profile
  control.

  File paths are relative to this directory (themes/dark/icons/).

  Icons referenced by theme.qss via url(theme:icons/...) are NOT loaded
  through this manifest — they are resolved by the "theme" Qt search path,
  which checks themes/{active}/ first and falls back to themes/light/.
-->
<icons>
    <type name="app">
        <icon key="add_view_icon"    file="plus-button.png"/>
        <icon key="add_trace_icon"   file="plus-button.png"/>
        <icon key="remove_trace_icon" file="minus-button.png"/>

        <!-- University of Seville logo, recoloured for the dark surface
             via HLS luminance inversion (hue and saturation preserved,
             brand colours intact, dark text and line work brightened to
             read on the dark surface). Generated by
             scripts/generate_dark_logo.py. -->
        <icon key="US-digital" file="US-marca-digital-cuadrada.png"/>
    </type>
</icons>
