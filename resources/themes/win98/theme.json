{
    "name": "Win98",
    "color_scheme": "light",
    "colors": {
        "window": "#c0c0c0",
        "alternate_base": "#ffffff",
        "text": "#000000",
        "text_muted": "#404040",
        "disabled_text": "#808080",
        "error": "#800000",
        "spellcheck_error": "#ff0000",
        "selection_bg": "#000080",
        "selection_text": "#ffffff",
        "hover_bg": "#c0c0c0",
        "hover_border": "#808080",
        "hover_text": "#000000",
        "pressed_bg": "#c0c0c0",
        "border": "#808080",
        "border_subtle": "#dfdfdf",
        "border_strong": "#000000",
        "bevel_light": "#ffffff",
        "bevel_shadow": "#808080",
        "button_surface": "#c0c0c0",
        "input_surface": "#ffffff",
        "header_surface": "#c0c0c0",
        "tooltip_surface": "#ffffe1",
        "tab_surface": "#c0c0c0",
        "tab_surface_inactive": "#c0c0c0",
        "chrome_surface": "#c0c0c0",
        "statusbar_surface": "#c0c0c0",
        "splitter_surface": "#c0c0c0",
        "scrollbar_handle": "#c0c0c0",
        "scrollbar_handle_hover": "#c0c0c0",
        "disabled_bg": "#c0c0c0",
        "calendar_accent": "#000080",
        "calendar_hover": "#000080",
        "calendar_pressed": "#c0c0c0",
        "calendar_text": "#ffffff"
    },
    "metrics": {
        "icon_size_button": 24,
        "icon_size_tab": 24,
        "icon_size_tree": 16,
        "icon_size_statusbar": 16,
        "profile_icon_height": 24,
        "tree_min_width": 220,
        "views_min_width": 420
    },
    "state_colors": {
        "fresh": "#008000",
        "dirty": "#808000",
        "dead": "#800000",
        "clean": "#000000"
    },
    "palette": {
        "window": "@window",
        "window_text": "@text",
        "base": "@input_surface",
        "alternate_base": "@alternate_base",
        "text": "@text",
        "button": "@button_surface",
        "button_text": "@text",
        "highlight": "@selection_bg",
        "highlighted_text": "@selection_text",
        "tool_tip_base": "@tooltip_surface",
        "tool_tip_text": "@text"
    }
}
