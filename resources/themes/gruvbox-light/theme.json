{
    "name": "Gruvbox Light",
    "color_scheme": "light",
    "colors": {
        "window": "#fbf1c7",
        "alternate_base": "#f2e5bc",
        "text": "#3c3836",
        "text_muted": "#665c54",
        "disabled_text": "#7c6f64",
        "error": "#9d0006",
        "spellcheck_error": "#cc241d",
        "selection_bg": "#076678",
        "selection_text": "#fbf1c7",
        "hover_bg": "#ebdbb2",
        "hover_border": "#928374",
        "hover_text": "#3c3836",
        "pressed_bg": "#d5c4a1",
        "border": "#a89984",
        "border_subtle": "#d5c4a1",
        "border_strong": "#7c6f64",
        "button_surface": "#ebdbb2",
        "input_surface": "#f9f5d7",
        "header_surface": "#ebdbb2",
        "tooltip_surface": "#f9f5d7",
        "tab_surface": "#fbf1c7",
        "tab_surface_inactive": "#ebdbb2",
        "chrome_surface": "#f2e5bc",
        "statusbar_surface": "#ebdbb2",
        "splitter_surface": "#d5c4a1",
        "scrollbar_handle": "#bdae93",
        "scrollbar_handle_hover": "#928374",
        "disabled_bg": "#f2e5bc",
        "calendar_accent": "#076678",
        "calendar_hover": "#458588",
        "calendar_pressed": "#d5c4a1",
        "calendar_text": "#fbf1c7"
    },
    "metrics": {
        "icon_size_button": 30,
        "icon_size_tab": 30,
        "icon_size_tree": 22,
        "icon_size_statusbar": 16,
        "profile_icon_height": 30,
        "tree_min_width": 220,
        "views_min_width": 420
    },
    "state_colors": {
        "fresh": "#427b58",
        "dirty": "#b57614",
        "dead": "#9d0006",
        "clean": "#3c3836"
    },
    "palette": {
        "window": "@window",
        "window_text": "@text",
        "base": "@input_surface",
        "alternate_base": "@alternate_base",
        "text": "@text",
        "button": "@button_surface",
        "button_text": "@text",
        "highlight": "@selection_bg",
        "highlighted_text": "@selection_text",
        "tool_tip_base": "@tooltip_surface",
        "tool_tip_text": "@text"
    }
}
