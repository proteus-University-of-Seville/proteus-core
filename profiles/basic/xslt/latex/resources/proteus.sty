% ==========================================================================
% File    : proteus.sty
% Content : PROTEUS LaTeX template style (counterpart of default.css)
% Author  : Amador Durán Toro
% Date    : 2026/10/07
% Version : 1.0
% ==========================================================================
% It works with xelatex, lualatex and pdflatex. The documents generated by
% the LaTeX template load it with \usepackage{resources/proteus}.
% ==========================================================================
\NeedsTeXFormat{LaTeX2e}
\ProvidesPackage{resources/proteus}[2026/10/07 PROTEUS LaTeX template style]

% --------------------------------------------------------------------------
% Fonts: Latin Modern (the default font of fontspec with xelatex and
% lualatex, lmodern with pdflatex). The whole document uses the sans serif
% family (\sffamily); typewriter is used for code.
% --------------------------------------------------------------------------
\RequirePackage{iftex}
\ifPDFTeX
  \RequirePackage[T1]{fontenc}
  \RequirePackage{lmodern}
\else
  \RequirePackage{fontspec}
\fi
\renewcommand{\familydefault}{\sfdefault}

% --------------------------------------------------------------------------
% Packages
% --------------------------------------------------------------------------
\RequirePackage[a4paper,margin=2.5cm]{geometry}
\RequirePackage[table]{xcolor}
\RequirePackage{graphicx}
\RequirePackage{array}
\RequirePackage{xltabular}
\RequirePackage{changepage}
\RequirePackage{amssymb}
\RequirePackage[normalem]{ulem}
\RequirePackage{float}
\RequirePackage{adjustbox}
\RequirePackage[most]{tcolorbox}
\RequirePackage{enumitem}
\RequirePackage{caption}
\RequirePackage{hyperref}

% --------------------------------------------------------------------------
% General layout
% --------------------------------------------------------------------------
\definecolor{proteusink}{HTML}{1D2433}
\definecolor{proteusline}{HTML}{DFE3E8}
\definecolor{proteuslink}{HTML}{1D4ED8}
\hypersetup{colorlinks, linkcolor=proteuslink, urlcolor=proteuslink, citecolor=proteuslink}

% twoside implies \flushbottom, which stretches the vertical space of pages
% that end before a card or a figure that does not fit
\raggedbottom
\setlength{\parindent}{0pt}
\setlength{\parskip}{0.5em}
% Paragraph spacing inside table cells, which reset \parskip to 0pt
\newlength{\proteus@parskip}
\setlength{\proteus@parskip}{\parskip}
\setcounter{secnumdepth}{4}
\setcounter{tocdepth}{3}
\setlist{nosep, leftmargin=1.5em}
\captionsetup{font=small, labelfont=bf}

% --------------------------------------------------------------------------
% Labels and anchors (object ids). They are disabled inside symbolic links,
% which render the linked objects again.
% --------------------------------------------------------------------------
\newif\ifproteus@inlink
\newcommand{\ProteusLabel}[1]{\ifproteus@inlink\else\label{#1}\fi}
\newcommand{\ProteusAnchor}[1]{\ifproteus@inlink\else\phantomsection\label{#1}\fi}

% --------------------------------------------------------------------------
% Accent colour per archetype (counterpart of --accent in the CSS files)
% \ProteusSetAccent{<main class>}{<HTML colour>}
% --------------------------------------------------------------------------
\definecolor{proteusaccent}{HTML}{475569}
\newcommand{\ProteusSetAccent}[2]{\expandafter\def\csname proteus@accent@#1\endcsname{#2}}
\newcommand{\ProteusUseAccent}[1]{%
  \ifcsname proteus@accent@#1\endcsname
    \definecolor{proteusaccent}{HTML}{\csname proteus@accent@#1\endcsname}%
  \else
    \definecolor{proteusaccent}{HTML}{475569}%
  \fi}
\ProteusSetAccent{organization}{0E7490}
\ProteusSetAccent{stakeholder}{6D28D9}
\ProteusSetAccent{meeting}{83900E}
\ProteusSetAccent{traceability-matrix}{4F46E5}

% --------------------------------------------------------------------------
% Tables (cards, Markdown tables, traceability matrices): rows separated
% by \arraystretch, \ProteusTableFraction of the text width, centred.
% --------------------------------------------------------------------------
\renewcommand{\arraystretch}{1.5}
\newcommand{\ProteusTableFraction}{0.95}
\newcommand{\ProteusTableWidth}{\ProteusTableFraction\linewidth}

% --------------------------------------------------------------------------
% Object cards (generate_table): an xltabular of width \ProteusTableWidth
% with a label column (L) and a value column (X). The header row is
% repeated on every page.
% --------------------------------------------------------------------------
% Space above and below each card (12pt between two cards; headings keep
% their own space above, since \addvspace takes the larger one)
\setlength{\LTpre}{\medskipamount}
\setlength{\LTpost}{\medskipamount}
% Cards are centred in the current text width (children cards are indented)
\AddToHook{env/xltabular/begin}{%
  \setlength{\LTleft}{\dimexpr\@totalleftmargin+(\linewidth-\ProteusTableWidth)/2\relax}%
  \setlength{\LTright}{0pt plus 1fill}}
% longtable steps the table counter: cards must not number tables, so the
% counter is saved at the beginning of each card and restored by
% \ProteusCardEnd, written by the template after \end{xltabular} (the
% end/after hooks of xltabular are not run, since it collects its body)
\AddToHook{env/xltabular/begin}{\xdef\proteus@tablecounter{\the\c@table}}
\newcommand{\ProteusCardEnd}{\setcounter{table}{\proteus@tablecounter}}
\arrayrulecolor{proteusline}
\newcolumntype{L}{>{\raggedright\arraybackslash\leavevmode\small\bfseries\color{proteusink!75}}p{0.23\linewidth}}
% Value column. Cells of X columns start in horizontal mode, so a list at
% the beginning of a cell would end that empty paragraph and leave an
% empty line above it. The content is set in a top-aligned minipage, which
% starts lists without space above and removes the space after a final
% list; \proteus@cellend adds the depth of the row strut instead, which
% the minipage would lose. \arraybackslash after \begin{minipage} keeps
% \\ as the end of the row.
\newcommand{\proteus@cellbegin}{%
  \begin{minipage}[t]{\linewidth}\setlength{\parskip}{\proteus@parskip}\arraybackslash}
\newcommand{\proteus@finalstrut}{%
  \ifhmode\@finalstrut\@arstrutbox\else\par\kern\dp\@arstrutbox\fi}
\newcommand{\proteus@cellend}{\proteus@finalstrut\end{minipage}}
\newcolumntype{Q}{>{\proteus@cellbegin}X<{\proteus@cellend}}

% Icons are copied from the profile to icons/<main class>.png
\newcommand{\ProteusIcon}[1]{\IfFileExists{icons/#1.png}{\raisebox{-0.2em}{\includegraphics[height=1.1em]{icons/#1.png}}\,}{}}

% \ProteusHeaderRow{<class>}{<class label>}{<code>}{<name>}
\newcommand{\ProteusHeaderRow}[4]{%
  \rowcolor{proteusaccent!12}%
  \ProteusIcon{#1}\textcolor{proteusaccent!82!black}{\footnotesize\MakeUppercase{#2}} &
  \textcolor{proteusaccent!82!black}{\bfseries\if\relax\detokenize{#3}\relax\else[#3]\nobreakspace\fi #4}\\ \hline}

\newcommand{\ProteusObjectImage}[1]{\hfill\raisebox{-0.5\height}{\includegraphics[height=3em]{#1}}}

% --------------------------------------------------------------------------
% Remote figures. The template writes \ProteusRemoteImage{<width>}{<URL>};
% the export strategies download the image and replace it by
% \includegraphics, or by \ProteusMissingImage{<link>} if the download
% failed. \ProteusMissingImageText is set by the template (i18n).
% --------------------------------------------------------------------------
\newcommand{\ProteusMissingImageText}{Remote figure not available}
\newcommand{\ProteusMissingImage}[1]{%
  \fbox{\parbox{0.8\linewidth}{\centering\ProteusTBD{\ProteusMissingImageText}\\ \small #1}}}
\newcommand{\ProteusChildren}[1]{\par\vspace{-0.6em}{\small\bfseries\color{proteusaccent!82!black}#1}\par\vspace{-0.4em}}
\newcommand{\ProteusTBD}[1]{\textcolor{red!70!black}{\textit{#1}}}

% --------------------------------------------------------------------------
% Markdown (see proteus_xslt_latex.py in the basic plugin)
% --------------------------------------------------------------------------
\newenvironment{proteuscode}{\par\small\ttfamily\raggedright\setlength{\parskip}{0pt}}{\par}
% Markdown tables: Y columns are left-aligned X columns (narrow justified
% columns hyphenate badly), set in a minipage like the value column of cards
\newcolumntype{Y}{>{\proteus@cellbegin\raggedright\arraybackslash}X<{\proteus@cellend}}
\newenvironment{proteusmdtable}[1]
  {\par\addvspace{\medskipamount}\centering\tabularx{\ProteusTableWidth}{|#1|}\hline}
  {\endtabularx\par\addvspace{\medskipamount}}

% --------------------------------------------------------------------------
% Bibliography (bibliography items). Like thebibliography but without its
% own heading, since bibliography items are placed in a section of the
% document, and with hanging labels as wide as needed ([<item name>]).
% \ProteusBibItem[<label>]{<id>} is \bibitem, which defines the citation
% \cite{<id>}; inside symbolic links it only shows the label, so that the
% citation is not defined twice.
% --------------------------------------------------------------------------
\newenvironment{proteusbibliography}
  {\list{}{%
     \setlength{\leftmargin}{1.5em}%
     \setlength{\labelwidth}{0pt}%
     \setlength{\labelsep}{0.5em}%
     \setlength{\itemindent}{-\leftmargin}%
     \setlength{\itemsep}{0.4em}%
     \setlength{\parsep}{0pt}%
     \renewcommand{\makelabel}[1]{\hspace{\labelsep}\normalfont\bfseries ##1}}%
   \sloppy\clubpenalty4000\widowpenalty4000}
  {\endlist}
\newcommand{\ProteusBibItem}[2][]{%
  \ifproteus@inlink\item[\@biblabel{#1}]\else\bibitem[#1]{#2}\fi}

% --------------------------------------------------------------------------
% Comments
% --------------------------------------------------------------------------
\newtcolorbox{proteuscomment}{breakable, colback=yellow!8, colframe=yellow!50!black,
  boxrule=0.4pt, leftrule=3pt, arc=2pt, fontupper=\small\itshape,
  before upper={\setlength{\parskip}{0.4em}}}

% --------------------------------------------------------------------------
% Symbolic links: indented block with a title (not a box, because cards
% are long tables, which cannot be placed inside boxes)
% --------------------------------------------------------------------------
\newenvironment{proteuslink}[1]
  {\par\proteus@inlinktrue
   \begin{adjustwidth}{1em}{0pt}%
   {\small\itshape\color{proteuslink}#1\par}}
  {\end{adjustwidth}\par}

\endinput
