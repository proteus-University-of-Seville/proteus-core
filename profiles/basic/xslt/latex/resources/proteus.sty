% ==========================================================================
% File    : proteus.sty
% Content : PROTEUS LaTeX template style (counterpart of default.css)
% Author  : Amador Durán Toro
% Date    : 2026/10/07
% Version : 1.0
% ==========================================================================
% It works with xelatex, lualatex and pdflatex. The documents generated by
% the LaTeX template load it with \usepackage{resources/proteus}.
% ==========================================================================
\NeedsTeXFormat{LaTeX2e}
\ProvidesPackage{resources/proteus}[2026/10/07 PROTEUS LaTeX template style]

% --------------------------------------------------------------------------
% Engine-dependent fonts
% --------------------------------------------------------------------------
\RequirePackage{iftex}
\ifPDFTeX
  \RequirePackage[T1]{fontenc}
  \RequirePackage{lmodern}
\else
  \RequirePackage{fontspec}
\fi

% --------------------------------------------------------------------------
% Packages
% --------------------------------------------------------------------------
\RequirePackage[a4paper,margin=2.5cm]{geometry}
\RequirePackage[table]{xcolor}
\RequirePackage{graphicx}
\RequirePackage{array}
\RequirePackage{xltabular}
\RequirePackage{changepage}
\RequirePackage{amssymb}
\RequirePackage[normalem]{ulem}
\RequirePackage{float}
\RequirePackage{adjustbox}
\RequirePackage[most]{tcolorbox}
\RequirePackage{enumitem}
\RequirePackage{caption}
\RequirePackage{hyperref}

% --------------------------------------------------------------------------
% General layout
% --------------------------------------------------------------------------
\definecolor{proteusink}{HTML}{1D2433}
\definecolor{proteusline}{HTML}{DFE3E8}
\definecolor{proteuslink}{HTML}{1D4ED8}
\hypersetup{colorlinks, linkcolor=proteuslink, urlcolor=proteuslink, citecolor=proteuslink}

\setlength{\parindent}{0pt}
\setlength{\parskip}{0.5em}
\setcounter{secnumdepth}{4}
\setcounter{tocdepth}{3}
\setlist{nosep, leftmargin=1.5em}
\captionsetup{font=small, labelfont=bf}

% --------------------------------------------------------------------------
% Labels and anchors (object ids). They are disabled inside symbolic links,
% which render the linked objects again.
% --------------------------------------------------------------------------
\newif\ifproteus@inlink
\newcommand{\ProteusLabel}[1]{\ifproteus@inlink\else\label{#1}\fi}
\newcommand{\ProteusAnchor}[1]{\ifproteus@inlink\else\phantomsection\label{#1}\fi}

% --------------------------------------------------------------------------
% Accent colour per archetype (counterpart of --accent in the CSS files)
% \ProteusSetAccent{<main class>}{<HTML colour>}
% --------------------------------------------------------------------------
\definecolor{proteusaccent}{HTML}{475569}
\newcommand{\ProteusSetAccent}[2]{\expandafter\def\csname proteus@accent@#1\endcsname{#2}}
\newcommand{\ProteusUseAccent}[1]{%
  \ifcsname proteus@accent@#1\endcsname
    \definecolor{proteusaccent}{HTML}{\csname proteus@accent@#1\endcsname}%
  \else
    \definecolor{proteusaccent}{HTML}{475569}%
  \fi}
\ProteusSetAccent{organization}{0E7490}
\ProteusSetAccent{stakeholder}{6D28D9}
\ProteusSetAccent{meeting}{83900E}
\ProteusSetAccent{traceability-matrix}{4F46E5}

% --------------------------------------------------------------------------
% Object cards (generate_table): an xltabular with a label column (L) and
% a value column (X). The header row is repeated on every page.
% --------------------------------------------------------------------------
% Cards start at the current left margin (children cards are indented)
\AddToHook{env/xltabular/begin}{\setlength{\LTleft}{\@totalleftmargin}\setlength{\LTright}{0pt}}
% longtable steps the table counter: cards must not number tables
\AddToHook{env/xltabular/end}{\addtocounter{table}{-1}}
\arrayrulecolor{proteusline}
\newcolumntype{L}{>{\raggedright\arraybackslash\leavevmode\small\bfseries\color{proteusink!75}}p{0.24\linewidth}}

% Icons are copied from the profile to icons/<main class>.png
\newcommand{\ProteusIcon}[1]{\IfFileExists{icons/#1.png}{\raisebox{-0.2em}{\includegraphics[height=1.1em]{icons/#1.png}}\,}{}}

% \ProteusHeaderRow{<class>}{<class label>}{<code>}{<name>}
\newcommand{\ProteusHeaderRow}[4]{%
  \rowcolor{proteusaccent!12}%
  \ProteusIcon{#1}\textcolor{proteusaccent!82!black}{\footnotesize\MakeUppercase{#2}} &
  \textcolor{proteusaccent!82!black}{\bfseries\if\relax\detokenize{#3}\relax\else[#3]\nobreakspace\fi #4}\\ \hline}

\newcommand{\ProteusObjectImage}[1]{\hfill\raisebox{-0.5\height}{\includegraphics[height=3em]{#1}}}
\newcommand{\ProteusChildren}[1]{\par\vspace{-0.6em}{\small\bfseries\color{proteusaccent!82!black}#1}\par\vspace{-0.4em}}
\newcommand{\ProteusTBD}[1]{\textcolor{red!70!black}{\textit{#1}}}

% --------------------------------------------------------------------------
% Markdown (see proteus_xslt_latex.py in the basic plugin)
% --------------------------------------------------------------------------
\newenvironment{proteuscode}{\par\small\ttfamily\raggedright\setlength{\parskip}{0pt}}{\par}
\newenvironment{proteusmdtable}[1]{\par\noindent\tabularx{\linewidth}{|#1|}\hline}{\endtabularx\par}

% --------------------------------------------------------------------------
% Comments
% --------------------------------------------------------------------------
\newtcolorbox{proteuscomment}{breakable, colback=yellow!8, colframe=yellow!50!black,
  boxrule=0.4pt, leftrule=3pt, arc=2pt, fontupper=\small\itshape,
  before upper={\setlength{\parskip}{0.4em}}}

% --------------------------------------------------------------------------
% Symbolic links: indented block with a title (not a box, because cards
% are long tables, which cannot be placed inside boxes)
% --------------------------------------------------------------------------
\newenvironment{proteuslink}[1]
  {\par\proteus@inlinktrue
   \begin{adjustwidth}{1em}{0pt}%
   {\small\itshape\color{proteuslink}#1\par}}
  {\end{adjustwidth}\par}

\endinput
