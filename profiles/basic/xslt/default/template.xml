<?xml version='1.0' encoding='UTF-8'?>
<!-- The template is language-independent: localized strings are retrieved at -->
<!-- render time with the proteus-utils:i18n() extension function, so a       -->
<!-- single entry point is needed for every language.                         -->
<template name="default">
    <entryPoints default="default.xsl"/>
    <dependencies>
        <pluginDependency name="basic"/>
    </dependencies>
</template>
